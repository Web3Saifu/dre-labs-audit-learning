[submodule "dreusd/lib/LayerZero-v2"]
	path = dreusd/lib/LayerZero-v2
	url = https://github.com/layerzero-labs/LayerZero-v2
[submodule "dreusd/lib/solidity-bytes-utils"]
	path = dreusd/lib/solidity-bytes-utils
	url = https://github.com/GNSPS/solidity-bytes-utils.git
[submodule "dreusd/lib/lz-address-book"]
	path = dreusd/lib/lz-address-book
